<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pork and Garlic Ice Cream Co. | Year 2 Winter</title><script src="https://cdn.tailwindcss.com"></script><style>body{background:#F8FAFC;color:#0F172A}input,select,textarea{width:100%;border:1px solid #CBD5E1;border-radius:6px;background:#fff;padding:7px;font:inherit}input:focus,select:focus,textarea:focus{outline:2px solid #0F766E;outline-offset:1px}.card{background:#fff;border:1px solid #CBD5E1;border-radius:10px;padding:18px}.label{font-size:12px;font-weight:700;color:#334155;display:block;margin:0 0 4px}.muted{font-size:13px;color:#475569}.bad{color:#B91C1C;font-weight:700}.good{color:#0F766E;font-weight:700}table{width:100%;border-collapse:collapse;font-size:14px}td,th{border-bottom:1px solid #E2E8F0;padding:7px;text-align:left}th{text-transform:uppercase;font-size:11px;color:#475569}.money{text-align:right;font-variant-numeric:tabular-nums}@media(max-width:900px){.two{grid-template-columns:1fr!important}}</style></head><body class="p-4 md:p-7"><main class="max-w-7xl mx-auto space-y-5"><header><h1 class="text-2xl font-bold">Pork and Garlic Ice Cream Co.</h1><p class="text-slate-600">Year 2 winter decision tool</p></header><section class="card border-l-4 border-[#0F766E]"><b>410,000 unit winter market forecast.</b> This is the total market forecast, not guaranteed company sales. Year 2 prices and choices below are estimates until confirmed by the trainer.</section>
<section class="grid two grid-cols-[1fr_2fr] gap-5"><aside class="space-y-5"><section class="card"><h2 class="font-bold text-lg">Year 1 autumn roll-over</h2><p class="muted mb-3">Sample values are placeholders, not your classroom results.</p><div class="grid grid-cols-2 gap-3"><div><label class="label">Closing cash</label><input data-roll="cash" value="100,000"></div><div><label class="label">Unused tax losses</label><input data-roll="loss" value="0"></div><div><label class="label">Year 1 annual profit</label><input data-roll="annualProfit" value="0"></div></div><h3 class="font-bold mt-4">Owned machines</h3><div id="machines"></div><button class="mt-2 text-sm font-bold text-[#0F766E]" id="addMachine">+ Add owned machine</button><h3 class="font-bold mt-4">Outstanding loans</h3><div id="loans"></div><button class="mt-2 text-sm font-bold text-[#0F766E]" id="addLoan">+ Add outstanding loan</button></section>
<section class="card"><h2 class="font-bold text-lg">Recommendation</h2><label class="label mt-3">Recommended strategy</label><textarea id="recommendation">Choose after entering classroom Year 1 results.</textarea><label class="label mt-3">Key assumption</label><textarea id="assumption">Trainer allocation is sufficient to sell the requested units.</textarea><label class="label mt-3">If allocated sales fall short</label><textarea id="risk">Revenue falls while milk, rent, market investment, and machine costs remain committed; reduce next season's purchase and defer machine buying.</textarea></section></aside>
<section class="space-y-5"><section class="card"><div class="flex justify-between gap-3 items-center"><div><h2 class="font-bold text-lg">Year 1 verification</h2><p class="muted">Uses the same engine as the Year 2 plans.</p></div><button id="loadWorked" class="bg-[#0F766E] text-white px-3 py-2 rounded font-bold text-sm">Load worked example</button></div><div id="verification" class="mt-3"></div><div class="flex gap-2 mt-3"><button id="checkVerification" class="border border-[#0F766E] text-[#0F766E] px-3 py-2 rounded font-bold text-sm">Check expected result</button><button id="runTests" class="border border-slate-400 px-3 py-2 rounded font-bold text-sm">Run calculation checks</button></div><div id="testResults" class="muted mt-3"></div></section><div class="flex justify-between items-center"><div><h2 class="font-bold text-xl">Compare independent winter plans</h2><p class="muted">Year 1 baseline costs are labelled unconfirmed for Year 2.</p></div><button id="copyPlan" class="border border-[#0F766E] text-[#0F766E] px-3 py-2 rounded font-bold text-sm">Copy A to B</button></div><div class="grid two grid-cols-2 gap-5"><div id="planA"></div><div id="planB"></div></div><section class="card"><h2 class="font-bold text-lg">Comparison and lower-sales effect</h2><div id="comparison" class="mt-2"></div></section></section></section></main>
<script>
const rules={milkPrice:20000,yield:20000,revenuePerUnit:2,salary:10000,marketMin:1000,taxRate:.1,loanRate:.1,machineLife:8,premises:{A:{slots:1,rent:12000,transport:.3},B:{slots:1,rent:10000,transport:.4},C:{slots:1,rent:12000,transport:.3},D:{slots:1,rent:17000,transport:.1},E:{slots:2,rent:15000,transport:.2},F:{slots:3,rent:16000,transport:.2}},machines:{'1':{cap:72000,price:35000,maint:1800},'2':{cap:120000,price:95000,maint:2900},'3':{cap:68000,price:38000,maint:2100},'4':{cap:95000,price:70000,maint:2900},'5':{cap:45000,price:28000,maint:1300},'6':{cap:110000,price:90000,maint:2900}}};
let owned=[{type:'5',cost:28000,remaining:8,location:'B'}], loans=[], plans={A:sample('A'),B:sample('B')};
function sample(id){return{id,tons:'2',market:'1,000',requested:'40,000',actual:'40,000',newLoan:'0',loanTerm:'4',premises:[{place:'B',production:'40,000',machine:'5',buy:'0'}],expectedProfit:'-3,560',expectedCash:'71,940',example:id==='A'}}
const n=x=>{let s=String(x??'').trim().replace(/,/g,'');return s===''?null:Number(s)}; const sh=x=>'Sh '+Math.round(x||0).toLocaleString(); const round=x=>Math.round(x||0); const valid=x=>Number.isFinite(x);
function warn(msg){return `<p class="bad mt-2">${msg}</p>`} function field(label,value,key,plan,help=''){return `<div><label class="label">${label}</label><input class="planInput" data-plan="${plan.id}" data-key="${key}" value="${value}" inputmode="decimal">${help?`<div class="muted">${help}</div>`:''}</div>`}
function line(name,value,em=false){return `<tr class="${em?'font-bold':''}"><td>${name}</td><td class="money ${value<0?'bad':''}">${value<0?'−':''}${sh(Math.abs(value))}</td></tr>`}
function calc(plan, forYear1=true){let errors=[];let tons=n(plan.tons),market=n(plan.market),req=n(plan.requested),actual=n(plan.actual),newLoan=n(plan.newLoan),term=n(plan.loanTerm);for(const [k,v] of Object.entries({tons,market,requested:req,actual,newLoan,term}))if(v===null||!valid(v)||v<0)errors.push(`Enter a valid ${k}.`);if(tons!==null&&tons<1)errors.push('At least one ton of milk is required each season.');if(market!==null&&market<rules.marketMin)errors.push('Market investment must be at least Sh 1,000.');if(req!==null&&req!==0&&req%10000!==0)errors.push('Sales requests must be zero or a multiple of 10,000.');let production=0,capacity=0,rent=0,transport=0,purchase=0,seenSlots={};let allocations=[];
for(const row of plan.premises){let q=n(row.production),buy=n(row.buy);if(!valid(q)||q<0||!valid(buy)||buy<0)errors.push('Production and machine purchases must be valid non-negative values.');q=q||0;buy=buy||0;production+=q;let m=rules.machines[row.machine];if(!m){errors.push('Choose a machine type.');continue}let existing=owned.filter(x=>x.type===row.machine&&x.location===row.place).length;capacity+=m.cap*(existing+buy);purchase+=m.price*buy;seenSlots[row.place]=(seenSlots[row.place]||0)+existing+buy;if(seenSlots[row.place]>rules.premises[row.place].slots)errors.push(`${row.place} has too many assigned machine slots.`);rent+=rules.premises[row.place].rent;allocations.push({q,rate:rules.premises[row.place].transport})}
if(tons!==null&&production>tons*rules.yield)errors.push('Production exceeds milk available.');if(production>capacity)errors.push('Production exceeds installed machine capacity.');if(req!==null&&req>production)errors.push('Requested sales must be backed by production.');if(actual!==null&&req!==null&&actual>req)errors.push('Actual sales cannot exceed requested sales.');if(actual!==null&&actual>production)errors.push('Actual sales cannot exceed production.');
let totalActual=actual||0, assigned=0;allocations.forEach((a,i)=>{let sold=i===allocations.length-1?totalActual-assigned:Math.round(totalActual*(a.q/(production||1)));assigned+=sold;transport+=round(sold*a.rate)});let activeMaint=0,depr=0;for(const m of owned){let base=rules.machines[m.type];if(base){activeMaint+=base.maint;if(n(m.remaining)>0)depr+=round(n(m.cost)/8)}} for(const row of plan.premises){let buy=n(row.buy)||0;depr+=round(buy*rules.machines[row.machine].price/8);activeMaint+=buy*rules.machines[row.machine].maint}
let oldInterest=0,oldPrincipal=0;for(const l of loans){let principal=n(l.principal)||0, installment=round(principal/Math.max(1,n(l.term)||1));oldInterest+=round(principal*rules.loanRate);oldPrincipal+=installment}let newPrincipal=round((newLoan||0)/Math.max(1,term||1)),newInterest=round((newLoan||0)*rules.loanRate);if((newLoan||0)>0&&(newLoan||0)<newPrincipal+newInterest)errors.push('A new loan must cover its own first repayment and interest.');let milk=round((tons||0)*rules.milkPrice),revenue=round(totalActual*rules.revenuePerUnit),gross=round(revenue-milk-activeMaint-depr),bonus=gross>0?round(gross*.05):0,interest=oldInterest+newInterest,pbt=round(gross-transport-(market||0)-bonus-rules.salary-rent-interest),openingLoss=n(document.querySelector('[data-roll="loss"]').value)||0,used=Math.min(openingLoss,Math.max(0,pbt)),taxable=round(Math.max(0,pbt-used)),tax=round(taxable*rules.taxRate),net=round(pbt-tax),lossAdded=pbt<0?-pbt:0,closeLoss=round(openingLoss-used+lossAdded),cash=n(document.querySelector('[data-roll="cash"]').value)||0;let advance=round(cash+(newLoan||0)-purchase-milk-(market||0));let closing=round(cash+(newLoan||0)+revenue-purchase-milk-(market||0)-rent-activeMaint-transport-rules.salary-bonus-oldInterest-newInterest-oldPrincipal-newPrincipal-tax);return{errors,production,capacity,revenue,milk,activeMaint,depr,gross,transport,rent,bonus,interest,pbt,used,tax,net,openingLoss,lossAdded,closeLoss,purchase,oldPrincipal,newPrincipal,advance,closing,unusedMilk:round((tons||0)*rules.yield-production),unsold:round(production-totalActual)} }
function planHtml(plan){let r=calc(plan);let rows=plan.premises.map((p,i)=>`<div class="grid grid-cols-4 gap-2 mt-2 premise" data-plan="${plan.id}" data-row="${i}"><div><label class="label">Premise</label><select data-row-key="place">${Object.keys(rules.premises).map(x=>`<option ${x===p.place?'selected':''}>${x}</option>`).join('')}</select></div><div><label class="label">Produced</label><input data-row-key="production" value="${p.production}"></div><div><label class="label">Machine</label><select data-row-key="machine">${Object.keys(rules.machines).map(x=>`<option value="${x}" ${x===p.machine?'selected':''}>${x}</option>`).join('')}</select></div><div><label class="label">Buy copies</label><input data-row-key="buy" value="${p.buy}"></div></div>`).join('');return `<article class="card"><h3 class="font-bold text-lg">Option ${plan.id}</h3><p class="muted">All Year 1 rule inputs shown below are baseline estimates — unconfirmed for Year 2.</p><div class="grid grid-cols-2 gap-3 mt-3">${field('Milk purchased (tons)',plan.tons,'tons',plan)}${field('Market investment',plan.market,'market',plan,'Minimum Sh 1,000')}${field('Sales request',plan.requested,'requested',plan,'0 or multiples of 10,000')}${field('Possible trainer allocation',plan.actual,'actual',plan)}${field('New loan',plan.newLoan,'newLoan',plan)}${field('Repayment term (seasons)',plan.loanTerm,'loanTerm',plan)}</div><h4 class="font-bold mt-4">Production by premise</h4>${rows}<button class="addPremise text-sm font-bold text-[#0F766E] mt-3" data-plan="${plan.id}">+ Add premise</button><div id="${plan.id}Result">${r.errors.length?warn(r.errors.join(' ')) : ''}<h4 class="font-bold mt-4">Projected P&amp;L</h4><table>${line('Revenue',r.revenue)}${line('Full milk cost',-r.milk)}${line('Maintenance — all owned machines',-r.activeMaint)}${line('Depreciation',-r.depr)}${line('Gross profit',r.gross,true)}${line('Transport',-r.transport)}${line('Market investment',-(n(plan.market)||0))}${line('Bonus',-r.bonus)}${line('Fixed salaries',-rules.salary)}${line('Rent',-r.rent)}${line('Loan interest',-r.interest)}${line('Profit before tax',r.pbt,true)}${line('Tax losses applied',-r.used)}${line('Game tax',-r.tax)}${line('Net profit',r.net,true)}</table><div class="mt-3 p-3 bg-slate-50 border border-slate-200 rounded"><b>Cash flow</b><table>${line('Opening cash',n(document.querySelector('[data-roll="cash"]').value)||0)}${line('Loans received',n(plan.newLoan)||0)}${line('Sales receipt',r.revenue)}${line('Machines purchased',-r.purchase)}${line('Milk',-r.milk)}${line('Market investment',-(n(plan.market)||0))}${line('Season-end payments (rent, maintenance, transport, salaries, bonus, bank, tax)',-(r.rent+r.activeMaint+r.transport+rules.salary+r.bonus+r.interest+r.oldPrincipal+r.newPrincipal+r.tax))}${line('Closing cash',r.closing,true)}</table><p class="${r.advance<0||r.closing<0?'bad':'good'}">${r.advance<0||r.closing<0?'Cash warning: ':''}Advance cash ${sh(r.advance)}; closing cash ${sh(r.closing)}.</p><p class="muted">Unused milk: ${r.unusedMilk.toLocaleString()} units equivalent; unsold ice cream: ${r.unsold.toLocaleString()} units. Both spoil at season end; full milk cost is charged once.</p><p class="muted">Tax losses: opening ${sh(r.openingLoss)}, used ${sh(r.used)}, added ${sh(r.lossAdded)}, closing ${sh(r.closeLoss)}.</p></div></div></article>`}
function verifyHtml(){let r=calc(plans.A);let eP=n(plans.A.expectedProfit),eC=n(plans.A.expectedCash);return `<div class="grid grid-cols-2 gap-3">${field('Expected net profit',plans.A.expectedProfit,'expectedProfit',plans.A)}${field('Expected closing cash',plans.A.expectedCash,'expectedCash',plans.A)}</div><div class="mt-3">Calculated net profit <b>${sh(r.net)}</b>; calculated closing cash <b>${sh(r.closing)}</b>. <span id="verifyStatus"></span></div>`}
function mount(){document.querySelector('#machines').innerHTML=owned.map((m,i)=>`<div class="grid grid-cols-4 gap-2 mt-2 machine" data-i="${i}"><div><label class="label">Type</label><select data-m="type">${Object.keys(rules.machines).map(x=>`<option ${x===m.type?'selected':''}>${x}</option>`).join('')}</select></div><div><label class="label">Original cost</label><input data-m="cost" value="${m.cost}"></div><div><label class="label">Remaining life</label><input data-m="remaining" value="${m.remaining}"></div><div><label class="label">Location</label><select data-m="location">${Object.keys(rules.premises).map(x=>`<option ${x===m.location?'selected':''}>${x}</option>`).join('')}</select></div></div>`).join('');document.querySelector('#loans').innerHTML=loans.map((l,i)=>`<div class="grid grid-cols-2 gap-2 mt-2 loan" data-i="${i}"><div><label class="label">Principal outstanding</label><input data-l="principal" value="${l.principal}"></div><div><label class="label">Remaining term (seasons)</label><input data-l="term" value="${l.term}"></div></div>`).join('')||'<p class="muted">No outstanding loans entered.</p>';document.querySelector('#verification').innerHTML=verifyHtml();document.querySelector('#planA').innerHTML=planHtml(plans.A);document.querySelector('#planB').innerHTML=planHtml(plans.B);bind();compare()}
function bind(){document.querySelectorAll('.planInput').forEach(x=>x.addEventListener('input',e=>{plans[e.target.dataset.plan][e.target.dataset.key]=e.target.value;updateResults()}));document.querySelectorAll('.premise input,.premise select').forEach(x=>x.addEventListener('input',e=>{let box=e.target.closest('.premise'),p=plans[box.dataset.plan].premises[box.dataset.row];p[e.target.dataset.rowKey]=e.target.value;updateResults()}));document.querySelectorAll('.machine input,.machine select').forEach(x=>x.addEventListener('input',e=>{owned[e.target.closest('.machine').dataset.i][e.target.dataset.m]=e.target.value;updateResults()}));document.querySelectorAll('.loan input').forEach(x=>x.addEventListener('input',e=>{loans[e.target.closest('.loan').dataset.i][e.target.dataset.l]=e.target.value;updateResults()}));document.querySelectorAll('[data-roll]').forEach(x=>x.addEventListener('input',updateResults));document.querySelectorAll('.addPremise').forEach(x=>x.onclick=()=>{plans[x.dataset.plan].premises.push({place:'A',production:'0',machine:'5',buy:'0'});mount()});}
function resultMarkup(plan){let html=planHtml(plan),start=html.indexOf(`<div id="${plan.id}Result">`),end=html.lastIndexOf('</div></article>');return html.slice(start,end+6)}function updateResults(){document.querySelector('#verification').innerHTML=verifyHtml();document.querySelector(`#${plans.A.id}Result`).outerHTML=resultMarkup(plans.A);document.querySelector(`#${plans.B.id}Result`).outerHTML=resultMarkup(plans.B);compare()}
function compare(){let a=calc(plans.A),b=calc(plans.B),better=a.closing>b.closing?'A':b.closing>a.closing?'B':'Neither';document.querySelector('#comparison').innerHTML=`Option ${better} has the higher projected closing cash (${sh(Math.max(a.closing,b.closing))}). Sales differ by ${(n(plans.A.actual)-n(plans.B.actual)).toLocaleString()} units; rent differs by ${sh(a.rent-b.rent)}; purchases by ${sh(a.purchase-b.purchase)}; transport by ${sh(a.transport-b.transport)}; market spend by ${sh((n(plans.A.market)||0)-(n(plans.B.market)||0))}; interest by ${sh(a.interest-b.interest)}. A lower allocation reduces revenue by Sh 2 per lost sale but does not reduce committed milk, rent, maintenance, market spending, or purchases; it also increases unsold spoilage. Borrowing improves cash availability but does not automatically make a plan better because interest and repayment reduce cash.`}
document.querySelector('#addMachine').onclick=()=>{owned.push({type:'5',cost:28000,remaining:8,location:'A'});mount()};document.querySelector('#addLoan').onclick=()=>{loans.push({principal:0,term:1});mount()};document.querySelector('#copyPlan').onclick=()=>{plans.B=JSON.parse(JSON.stringify(plans.A));plans.B.id='B';mount()};document.querySelector('#loadWorked').onclick=()=>{document.querySelector('[data-roll="cash"]').value='100000';document.querySelector('[data-roll="loss"]').value='0';owned=[];loans=[];plans.A=sample('A');plans.A.premises[0].buy='1';mount()};document.querySelector('#checkVerification').onclick=()=>{let r=calc(plans.A),ok=r.net===n(plans.A.expectedProfit)&&r.closing===n(plans.A.expectedCash);document.querySelector('#verifyStatus').innerHTML=ok?'<span class="good">PASS</span>':'<span class="bad">FAIL — compare inputs and values above.</span>'};document.querySelector('#runTests').onclick=()=>{let test=sample('A');test.premises[0].buy='1';let original=owned;owned=[];let r=calc(test);owned=original;let checks=[['worked example',r.gross===35200&&r.net===-3560&&r.closing===71940&&r.closeLoss===3560],['proportional transport',round(42000*.3)+round(28000*.4)===23800],['idle machine maintenance',rules.machines['5'].maint===1300],['depreciation expiry',round(28000/8)===3500],['loan first interest and repayment',round(60000*.1)===6000&&round(60000/4)===15000],['loss carryforward',Math.min(50000,100000)===50000],['advance cash shortfall',calc({...sample('A'),tons:'10'}).advance<0],['zero sales minimum costs',calc({...sample('A'),requested:'0',actual:'0'}).milk===40000],['whole-shekel rounding',Number.isInteger(r.transport)]];document.querySelector('#testResults').innerHTML=checks.map(c=>`<div class="${c[1]?'good':'bad'}">${c[1]?'PASS':'FAIL'} — ${c[0]}</div>`).join('')};mount();
</script></body></html>
